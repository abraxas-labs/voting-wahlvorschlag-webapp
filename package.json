{
  "name": "@abraxas/voting-wahlvorschlag-webapp",
  "version": "0.0.0-development",
  "scripts": {
    "build": "ng build",
    "build:stats": "ng build --configuration=production --stats-json=true",
    "build:prod": "ng build --configuration=production",
    "lint": "ng lint && npm run lint:styles",
    "lint:ci": "ng lint --format json > eslint-report.json",
    "lint:styles": "stylelint ./src/**/*.scss",
    "lint:license": "eslint --fix .",
    "ng": "ng",
    "npx": "npx",
    "prepare": "husky install",
    "prettier": "npx prettier --write ./src/**/*.{ts,scss,html,json}",
    "fix": "prettier --write . && ng lint --fix && stylelint \"./src/**/*.scss\" --fix",
    "server": "ng serve voting-stimmregister-webapp -o",
    "start": "ng serve --port=4221",
    "stylelint-check": "stylelint-config-prettier-check"
  },
  "private": true,
  "dependencies": {
    "@abraxas/base-components": "21.30.0",
    "@abraxas/voting-lib": "0.0.1-dev.797",
    "@angular/animations": "21.2.8",
    "@angular/cdk": "21.2.6",
    "@angular/cdk-experimental": "21.2.6",
    "@angular/common": "21.2.8",
    "@angular/compiler": "21.2.8",
    "@angular/core": "21.2.8",
    "@angular/forms": "21.2.8",
    "@angular/material": "21.2.6",
    "@angular/material-moment-adapter": "21.2.6",
    "@angular/platform-browser": "21.2.8",
    "@angular/platform-browser-dynamic": "21.2.8",
    "@angular/router": "21.2.8",
    "@ngx-translate/core": "17.0.0",
    "file-saver": "2.0.5",
    "moment": "2.30.1",
    "rxjs": "7.8.2",
    "uuid": "13.0.0",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "21.3.1",
    "@angular-eslint/eslint-plugin": "21.3.1",
    "@angular-eslint/eslint-plugin-template": "21.3.1",
    "@angular-eslint/schematics": "21.3.1",
    "@angular-eslint/template-parser": "21.3.1",
    "@angular/build": "21.2.7",
    "@angular/cli": "21.2.7",
    "@angular/compiler-cli": "21.2.8",
    "@angular/language-service": "21.2.8",
    "@types/file-saver": "2.0.7",
    "@types/google-protobuf": "3.15.12",
    "@types/node": "25.5.0",
    "@types/uuid": "11.0.0",
    "@typescript-eslint/eslint-plugin": "8.57.2",
    "@typescript-eslint/parser": "8.57.2",
    "deepmerge": "4.3.1",
    "eslint": "9.39.4",
    "eslint-plugin-license-header": "0.9.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.8.1",
    "stylelint": "17.6.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-scss": "7.0.0",
    "typescript": "5.9.3"
  },
  "author": "Abraxas Informatik AG"
}
